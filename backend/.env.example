# Database
# Passwords with special characters must be URL-encoded.
# 
DATABASE_URL=postgresql+asyncpg://USER:<URL_ENCODED_PASSWORD>@DATABASENAME.postgres.database.azure.com:5432/pharmatrackrx?ssl=require

# Redis
REDIS_URL=redis://:redissecret@localhost:6379/0
REDIS_PASSWORD=redissecret

# Security
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# File Storage (MinIO / S3-compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=pharmatrackrx
S3_REGION=us-east-1

# Application
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
API_PREFIX=/api/v1

# Default Tenant
DEFAULT_TENANT_NAME=Prince Pharma
DEFAULT_ADMIN_EMAIL=admin@princepharma.com
DEFAULT_ADMIN_PASSWORD=changeme123
